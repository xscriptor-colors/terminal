hide_window_decorations yes
tab_bar_style hidden
draw_minimal_borders yes
background_opacity 0.85
dynamic_background_opacity yes
window_margin_width 0
font_family Hack Nerd Font
bold_font auto
italic_font auto
bold_italic_font auto
font_size 8.0
copy_on_select yes
clipboard_control write-clipboard read-clipboard write-primary read-primary
mouse_hide_wait 3.0
mouse_map left press ungrabbed mouse_selection normal
mouse_map left doublepress ungrabbed mouse_selection word
mouse_map left triplepress ungrabbed mouse_selection line
mouse_map right press ungrabbed paste_from_selection
mouse_map middle press ungrabbed paste_from_clipboard
url_style curly
open_url_modifiers kitty_mod
open_url_with default
detect_urls yes
cursor_trail 12
custom_shaders x-trail
window_padding_width 30
window_border_width 2
active_border_color #87CEEB

# Do not restore the size/maximized state of the previous OS window
remember_window_size no
# Do not restore the position of the previous OS window
remember_window_position no
initial_window_width 1100
initial_window_height 650
