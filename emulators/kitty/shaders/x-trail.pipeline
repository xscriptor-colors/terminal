# X Lightning: jagged electric cursor trail. Requires kitty >= 0.49 and slangc.
# Keep cursor_trail enabled (cursor_trail 12 / threshold 0 in kitty.conf).

startgroup
    animation_start cursor-trail-move
    animation_stop 720
    animation_step 8

    var float BOLT_DURATION 0.32
    var float BOLT_CORE_WIDTH 1.0
    var float BOLT_GLOW_WIDTH 5.0
    var float BOLT_JAGGEDNESS 0.11
    var float MIN_MOVE_PX 0.0
    var float MAX_BOLT_LENGTH 280.0
    var int BOLT_SEGMENTS 12
    var int FORK_COUNT 4
    var float BOLT_INTENSITY 0.75
    var float AFTERGLOW 0.22
    var float FLICKER 0.04

    var float SPARK_OPACITY 0.55
    var int MAX_SPARKS 18
    var float SPARK_LIFETIME 0.36
    var float SPARK_EMIT 0.12
    var float SPARK_SPEED 5.0
    var float SPARK_SPREAD 1.0
    var float SPARK_SIZE 0.09
    var float SPARK_DRAG 1.1

    var float3 BOLT_CORE_COLOR float3(0.75, 0.92, 1.0)
    var float3 BOLT_GLOW_COLOR float3(0.25, 0.50, 1.0)
    var float3 BOLT_ACCENT_COLOR float3(0.55, 0.35, 1.0)
    var float3 SPARK_COLOR float3(0.70, 0.90, 1.0)

    shaders x-lightning
endgroup
